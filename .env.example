DB_HOST=localhost
DB_PORT=5432
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering

# SQS (LocalStack local). Em produção, remova SQS_ENDPOINT e use credenciais reais da AWS.
SQS_ENDPOINT=http://localhost:4566
SQS_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Workers
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
SQS_CONSUMER_ENABLED=true
